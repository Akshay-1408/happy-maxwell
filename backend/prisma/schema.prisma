generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("STUDENT")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  studentProfile StudentProfile?
  assessments    Assessment[]
  savedCareers   SavedCareer[]
  comparisons    CareerComparison[]

  @@index([email])
}

model StudentProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  studentName            String
  age                    Int?
  currentClass           String   @default("10th")
  board                  String?
  state                  String?
  city                   String?
  percentageObtained     Float?
  isPercentageExpected   Boolean  @default(false)
  strongSubjects         String   @default("[]")
  enjoyedSubjects        String   @default("[]")
  dislikedSubjects       String   @default("[]")
  preferredStudyLocation String?  @default("HOME_STATE")
  budgetPreference       String?  @default("BUDGET_FRIENDLY")
  wantsHigherEducation   Boolean? @default(true)
  careerInterests        String   @default("[]")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id          String   @id @default(cuid())
  userId      String?
  status      String   @default("IN_PROGRESS")
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]
  results   AssessmentResult[]

  @@index([userId])
}

model AssessmentQuestion {
  id           String   @id @default(cuid())
  questionText String
  questionType String   @default("LIKERT")
  category     String   @default("INTEREST")
  options      String?  @default("[]")
  scoring      String   @default("{}")
  orderIndex   Int      @default(0)
  isActive     Boolean  @default(true)

  responses AssessmentResponse[]
}

model AssessmentResponse {
  id           String   @id @default(cuid())
  assessmentId String
  questionId   String
  answerValue  String
  createdAt    DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model AssessmentResult {
  id                 String   @id @default(cuid())
  assessmentId       String
  userId             String?
  categoryScores     String   @default("[]")
  topPathways        String   @default("[]")
  recommendedCareers String   @default("[]")
  summary            String
  skillsToDevelop    String   @default("[]")
  nextActions        String   @default("[]")
  createdAt          DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CareerCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String
  iconName    String?
  orderIndex  Int      @default(0)

  careers Career[]
}

model Career {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  categoryId         String
  shortDescription   String
  fullDescription    String
  relevantStreams    String   @default("[]")
  requiredEducation  String   @default("[]")
  durationToQualify  String?
  workEnvironment    String?
  whoMightEnjoy      String?
  alternativeRoutes  String   @default("[]")
  skills             String   @default("[]")
  toolsUsed          String   @default("[]")
  pros               String   @default("[]")
  challenges         String   @default("[]")
  isFeatured         Boolean  @default(false)
  isActive           Boolean  @default(true)
  orderIndex         Int      @default(0)

  category     CareerCategory @relation(fields: [categoryId], references: [id])
  savedByUsers SavedCareer[]

  @@index([categoryId])
  @@index([slug])
}

model Pathway {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  stream                 String
  shortDescription       String
  difficultyLevel        String   @default("MODERATE")
  duration               String
  keySubjects            String   @default("[]")
  entranceExams          String   @default("[]")
  higherEducationOptions String   @default("[]")
  commonCareers          String   @default("[]")
  steps                  String   @default("[]")
  orderIndex             Int      @default(0)
  isActive               Boolean  @default(true)
}

model College {
  id          String   @id @default(cuid())
  name        String
  city        String
  state       String
  type        String   @default("GOVERNMENT")
  affiliation String?
  ranking     Int?
  website     String?
  isDemoData  Boolean  @default(true)

  courses Course[]
}

model Course {
  id          String  @id @default(cuid())
  collegeId   String
  name        String
  degreeType  String  @default("UNDERGRADUATE")
  duration    String
  eligibility String?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

model SavedCareer {
  id        String   @id @default(cuid())
  userId    String
  careerId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
}

model CareerComparison {
  id        String   @id @default(cuid())
  userId    String
  careerIds String   @default("[]")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
