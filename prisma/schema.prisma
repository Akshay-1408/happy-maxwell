// Prisma Schema configured for PostgreSQL & Vercel deployment

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models (NextAuth / Auth.js) ────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(STUDENT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  studentProfile StudentProfile?
  assessments    Assessment[]
  savedCareers   SavedCareer[]
  savedColleges  SavedCollege[]
  goals          StudentGoal[]
  comparisons    CareerComparison[]

  @@index([email])
}

enum UserRole {
  STUDENT
  PARENT
  COUNSELOR
  ADMIN
}

// ─── Student Profile ─────────────────────────────────────────────────────────

model StudentProfile {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  studentName            String
  age                    Int?
  currentClass           String   @default("10th")
  board                  String?
  state                  String?
  city                   String?
  percentageObtained     Float?
  isPercentageExpected   Boolean  @default(false)
  mathMarks              Float?
  scienceMarks           Float?
  englishMarks           Float?
  socialMarks            Float?
  strongSubjects         String[] @default([])
  enjoyedSubjects        String[] @default([])
  dislikedSubjects       String[] @default([])
  hobbies                String[] @default([])
  learningStyle          String?  @default("PRACTICAL_HANDS_ON")
  workEnvironment        String?  @default("TECH_OFFICE")
  preferredStudyLocation String?  @default("HOME_STATE")
  budgetPreference       String?  @default("BUDGET_FRIENDLY")
  govtPrivatePref        String?  @default("ANY")
  targetCity             String?
  wantsHigherEducation   Boolean? @default(true)
  careerInterests        String[] @default([])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Assessment ──────────────────────────────────────────────────────────────

model Assessment {
  id          String   @id @default(cuid())
  userId      String?
  status      String   @default("IN_PROGRESS")
  startedAt   DateTime @default(now())
  completedAt DateTime?

  user      User?                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses AssessmentResponse[]
  results   AssessmentResult[]

  @@index([userId])
}

model AssessmentQuestion {
  id           String   @id @default(cuid())
  questionText String
  questionType String   @default("LIKERT") // LIKERT, MCQ, SCENARIO, SUBJECT_PREFERENCE
  category     String   @default("INTEREST") // INTEREST, APTITUDE, PERSONALITY, ACADEMIC, CAREER_PREF
  options      Json?    @default("[]")
  scoring      Json     @default("{}")
  orderIndex   Int      @default(0)
  isActive     Boolean  @default(true)

  responses AssessmentResponse[]
}

model AssessmentResponse {
  id           String   @id @default(cuid())
  assessmentId String
  questionId   String
  answerValue  String
  createdAt    DateTime @default(now())

  assessment Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
}

model AssessmentResult {
  id                 String   @id @default(cuid())
  assessmentId       String
  userId             String?
  categoryScores     Json     @default("[]")
  topPathways        Json     @default("[]")
  recommendedCareers Json     @default("[]")
  summary            String   @db.Text
  strengths          Json     @default("[]")
  skillsToDevelop    Json     @default("[]")
  nextActions        Json     @default("[]")
  roadmap            Json     @default("{}")
  createdAt          DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Career & Taxonomy ───────────────────────────────────────────────────────

model CareerCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String   @db.Text
  iconName    String?
  orderIndex  Int      @default(0)

  careers Career[]
}

model Career {
  id                 String   @id @default(cuid())
  name               String
  slug               String   @unique
  categoryId         String
  shortDescription   String   @db.Text
  fullDescription    String   @db.Text
  relevantStreams    String[] @default([])
  requiredEducation  String[] @default([])
  degreesOrDiplomas  String[] @default([])
  entranceExams      String[] @default([])
  recommendedSubjects String[] @default([])
  durationToQualify  String?
  workEnvironment    String?
  salaryRangeMin     Float?   // in LPA (Lakhs Per Annum)
  salaryRangeMax     Float?
  salaryRangeLabel   String?  // e.g. "₹4.5 - 18 LPA"
  growthOutlook      String?  @default("HIGH") // HIGH, VERY_HIGH, MODERATE, STABLE
  whoMightEnjoy      String?  @db.Text
  alternativeRoutes  String[] @default([])
  skills             String[] @default([])
  toolsUsed          String[] @default([])
  pros               String[] @default([])
  challenges         String[] @default([])
  isFeatured         Boolean  @default(false)
  isActive           Boolean  @default(true)
  orderIndex         Int      @default(0)

  category     CareerCategory @relation(fields: [categoryId], references: [id])
  savedByUsers SavedCareer[]

  @@index([categoryId])
  @@index([slug])
}

// ─── Pathway ─────────────────────────────────────────────────────────────────

model Pathway {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String   @unique
  stream                 String
  shortDescription       String   @db.Text
  difficultyLevel        String   @default("MODERATE")
  duration               String
  keySubjects            String[] @default([])
  entranceExams          String[] @default([])
  higherEducationOptions String[] @default([])
  commonCareers          String[] @default([])
  steps                  Json     @default("[]")
  orderIndex             Int      @default(0)
  isActive               Boolean  @default(true)
}

// ─── Colleges ────────────────────────────────────────────────────────────────

model College {
  id                 String   @id @default(cuid())
  name               String
  city               String
  state              String
  type               String   @default("GOVERNMENT") // IIT, NIT, AIIMS, GOVERNMENT, PRIVATE, STATE_GOVT
  affiliation        String?
  ranking            Int?
  feesRange          String?  @default("₹10,000 - ₹50,000 / year")
  admissionProcess   String?  @db.Text
  entranceExams      String[] @default([])
  facilities         String[] @default([])
  website            String?
  studentSuitability String?  @db.Text
  estYear            Int?
  isDemoData         Boolean  @default(false)

  courses      Course[]
  savedByUsers SavedCollege[]
}

model Course {
  id          String  @id @default(cuid())
  collegeId   String
  name        String
  degreeType  String  @default("UNDERGRADUATE") // DIPLOMA, UNDERGRADUATE, INTEGRATED
  duration    String
  eligibility String?
  feePerYear  String?

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
}

// ─── Saved Items & Goals ─────────────────────────────────────────────────────

model SavedCareer {
  id        String   @id @default(cuid())
  userId    String
  careerId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)

  @@unique([userId, careerId])
}

model SavedCollege {
  id        String   @id @default(cuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
}

model StudentGoal {
  id          String    @id @default(cuid())
  userId      String
  title       String
  timeframe   String    @default("30_DAYS") // 30_DAYS, 3_MONTHS, 6_MONTHS, 1_YEAR
  category    String    @default("ACADEMIC") // ACADEMIC, EXPLORATION, APPLICATION, SKILL
  completed   Boolean   @default(false)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model CareerComparison {
  id        String   @id @default(cuid())
  userId    String
  careerIds String[] @default([])
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
